# Normalise line endings in the repository to LF, whatever the working copy uses.
# This is a Windows machine and git's autocrlf would otherwise record CRLF, which
# shows up as a whole-file diff the first time anyone touches the repo elsewhere.
* text=auto eol=lf

# Windows batch files MUST keep CRLF. cmd.exe mis-parses multi-line blocks and
# `goto :label` with bare LF, and it does so silently: the file runs and does the
# wrong thing rather than reporting an error.
*.bat text eol=crlf

# Never touch these.
*.png binary
*.jpg binary
*.webp binary
*.ico binary
